{
  "name": "yohaku-contract",
  "description": "core contract for Yohaku NFT",
  "license": "MIT",
  "scripts": {
    "setup": "pnpm install && forge install && cp .env.example .env",
    "compile": "forge fmt && forge compile",
    "build": "forge fmt && forge build",
    "test:coverage": "forge coverage",
    "test:op": "forge clean && forge fmt && forge test --fork-url optimism --fork-block-number 132218259 --match-path test/foundry/Yohaku.t.sol",
    "deploy:yohaku-op": "forge script script/YohakuNFT.s.sol --rpc-url optimism --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key optimism --verify",
    "deploy:factory-op": "forge script script/NFTFactory.s.sol --rpc-url optimism --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key optimism --verify",
    "format": "forge fmt",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.5"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.4",
    "dotenv": "^16.4.5"
  }
}
