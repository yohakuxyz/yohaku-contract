{
  "name": "yohaku-contract",
  "description": "core contract for Yohaku NFT",
  "license": "MIT",
  "scripts": {
    "compile": "forge compile",
    "build": "forge build",
    "test:coverage": "forge coverage",
    "test:op": "forge test --fork-url https://mainnet.optimism.io --match-path test/foundry/Yohaku.t.sol",
    "deploy:yohaku-op": "forge script script/YohakuNFT.s.sol --rpc-url $OPTIMISM_MAINNET_RPC_URL --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key $API_KEY_OPTIMISTIC_ETHERSCAN --verify",
    "deploy:factory-op": "forge script script/NFTFactory.s.sol --rpc-url $OPTIMISM_MAINNET_RPC_URL --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key $API_KEY_OPTIMISTIC_ETHERSCAN --verify",
    "format": "forge fmt",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.5"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.4",
    "dotenv": "^16.4.5"
  }
}
