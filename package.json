{
  "name": "yohaku-contract",
  "description": "core contract for Yohaku NFT",
  "license": "MIT",
  "scripts": {
    "setup": "pnpm install && forge install && cp .env.example .env",
    "compile": "forge fmt && forge compile",
    "build": "forge fmt && forge build",
    "test:coverage": "forge coverage --fork-url https://mainnet.optimism.io --fork-block-number 132218259 --no-match-coverage '(script|test)'",
    "test:coverage:report": "forge coverage --fork-url https://mainnet.optimism.io --report lcov && genhtml lcov.info --branch-coverage --output-dir coverage",
    "test:op": "forge clean && forge fmt && forge test --fork-url https://mainnet.optimism.io --fork-block-number 132218259 --match-path test/foundry/Yohaku.t.sol",
    "deploy:yohaku-op": "forge script script/DeployYohaku.s.sol --rpc-url https://mainnet.optimism.io --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key optimism --verify",
    "deploy:yohaku-sepolia": "forge script script/DeployYohaku.s.sol --rpc-url https://sepolia.drpc.org --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key sepolia --verify",
    "deploy:factory-op": "forge script script/DeployNFTFactory.s.sol --rpc-url https://mainnet.optimism.io --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key optimism --verify",
    "deploy:factory-sepolia": "forge script script/DeployNFTFactory.s.sol --rpc-url https://sepolia.drpc.org --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key sepolia --verify",
    "deploy:cnft-sepolia": "forge script script/DeployContributionNFT.s.sol --rpc-url https://sepolia.drpc.org --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --etherscan-api-key sepolia --verify",
    "upgrade:yohaku-sepolia": "forge script script/UpgradeYohaku.s.sol --rpc-url https://sepolia.drpc.org --broadcast -vvvv --private-key $DEPLOYER_PRIVATE_KEY --sender 0x67Df9d563032dAA77273a689041bC9cFC1B35911 --etherscan-api-key sepolia --verify",
    "format": "forge fmt",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.23.0"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.11",
    "dotenv": "^16.5.0"
  }
}
